# --- LLM: fake | claude | gemini | openrouter | agy (CLI Antigravity, sin API key) ---
UNSA_LLM_PROVIDER=fake
# UNSA_LLM_MODEL=
# UNSA_LLM_FALLBACK_MODELS=["modelo-b","modelo-c"]
# UNSA_ANTHROPIC_API_KEY=
# UNSA_GEMINI_API_KEY=
# UNSA_OPENROUTER_API_KEY=
# UNSA_AGY_BIN=agy

# --- Embeddings: hashing (offline) | gemini | openai_compat | local ---
UNSA_EMBEDDER_PROVIDER=hashing
# UNSA_EMBEDDER_DIMENSION=512
# UNSA_EMBEDDER_BASE_URL=https://openrouter.ai/api/v1
# UNSA_EMBEDDER_API_KEY=

# --- Almacenamiento: sqlite (por defecto) | qdrant | memory ---
UNSA_VECTOR_STORE=sqlite
UNSA_REPOSITORY=sqlite
UNSA_DATA_DIR=data
# UNSA_QDRANT_URL=http://localhost:6333

# --- Scraping y actualización programada ---
UNSA_FETCHER=httpx
UNSA_REQUEST_DELAY_S=1.0
UNSA_RESPECT_ROBOTS=true
UNSA_SCHEDULE_ENABLED=true
UNSA_SCHEDULE_INTERVAL_MINUTES=1440
# UNSA_SCHEDULE_CRON=0 3 * * *

# --- API ---
UNSA_PORT=8000
UNSA_ADMIN_TOKEN=cambiar-esto
UNSA_PUBLIC_URL=http://localhost:8000
