# --- LLM: fake | claude | gemini | openrouter | agy (CLI Antigravity, sin API key) ---
UNSA_LLM_PROVIDER=fake
# UNSA_LLM_MODEL=
# UNSA_LLM_FALLBACK_MODELS=["modelo-b","modelo-c"]
# UNSA_ANTHROPIC_API_KEY=
# UNSA_GEMINI_API_KEY=
# UNSA_OPENROUTER_API_KEY=
# UNSA_AGY_BIN=agy

# --- Embeddings: hashing (offline, solo pruebas) | gemini | openai_compat | local ---
# Recomendado para calidad real: BGE-M3 (pip install -e ".[local-embeddings]" o `make install-bge`)
#   y descomentar las dos líneas siguientes, en lugar de las de hashing. Cambiar exige reindexar.
# UNSA_EMBEDDER_PROVIDER=local
# UNSA_EMBEDDER_DIMENSION=1024
UNSA_EMBEDDER_PROVIDER=hashing
UNSA_EMBEDDER_DIMENSION=512
# UNSA_EMBEDDER_BASE_URL=https://openrouter.ai/api/v1
# UNSA_EMBEDDER_API_KEY=

# --- OCR de PDF escaneados: none | tesseract (liviano, local; libros) | agy (modelo de visión) ---
# tesseract: `make install-ocr-light` + `sudo apt install tesseract-ocr tesseract-ocr-spa`
# agy (y DOCX/PPTX/XLSX): `make install-ocr`
# UNSA_OCR_PROVIDER=tesseract
# UNSA_OCR_LANG=spa            # solo tesseract (p. ej. spa+eng)
# UNSA_OCR_MODEL=gemini-3.8-flash-medium   # solo agy
# UNSA_OCR_TIMEOUT_S=120
# UNSA_OCR_MAX_PAGES=0         # 0 = automático: agy 80, tesseract 1000
# UNSA_OCR_CONCURRENCY=3

# --- Almacenamiento: sqlite (por defecto) | qdrant | memory ---
UNSA_VECTOR_STORE=sqlite
UNSA_REPOSITORY=sqlite
UNSA_DATA_DIR=data
# UNSA_QDRANT_URL=http://localhost:6333

# --- Scraping y actualización programada ---
UNSA_FETCHER=httpx
UNSA_REQUEST_DELAY_S=1.0
UNSA_RESPECT_ROBOTS=true
UNSA_SCHEDULE_ENABLED=true
UNSA_SCHEDULE_INTERVAL_MINUTES=1440
# UNSA_SCHEDULE_CRON=0 3 * * *

# --- API ---
UNSA_PORT=8000
UNSA_ADMIN_TOKEN=cambiar-esto
UNSA_PUBLIC_URL=http://localhost:8000
